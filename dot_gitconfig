[user]
	name = Ozan Ozbeker
	email = github@ozanozbeker.com
[init]
	defaultBranch = main
[core]
	editor = zed --wait
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[alias]
	sync = "!git switch main && git pull && git for-each-ref --format=\"%(refname:short) %(upstream:track)\" refs/heads | while read -r branch track; do if [ \"$track\" = \"[gone]\" ]; then git branch -D \"$branch\"; fi; done"
