{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.columnar.tech)",
      "WebFetch(domain:pypi.org)"
    ]
  },
  "model": "fable",
  "enabledPlugins": {
    "polars@polars": true,
    "dagster-expert@dagster": true,
    "mattpocock-skills@mattpocock": true,
    "caveman@caveman": true,
    "oxylabs@oxylabs-agent-skills": false,
    "dbt@dbt-agent-marketplace": true,
    "ozanozbeker-skills@ozanozbeker": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "dagster": {
      "source": {
        "source": "github",
        "repo": "dagster-io/skills"
      }
    },
    "polars": {
      "source": {
        "source": "github",
        "repo": "polars-inc/skills"
      }
    },
    "posit-dev-skills": {
      "source": {
        "source": "github",
        "repo": "posit-dev/skills"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "oxylabs-agent-skills": {
      "source": {
        "source": "github",
        "repo": "oxylabs/agent-skills"
      }
    },
    "dbt-agent-marketplace": {
      "source": {
        "source": "github",
        "repo": "dbt-labs/dbt-agent-skills"
      }
    },
    "ozanozbeker": {
      "source": {
        "source": "github",
        "repo": "ozanozbeker/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-opus-5-5": {},
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
